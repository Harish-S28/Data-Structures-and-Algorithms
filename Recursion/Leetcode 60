class Solution {
    int g=0;
    public String getPermutation(int n, int k) {
        int[] nums=new int[n];
        for(int i=1;i<=n;i++){
            nums[i-1]=i;
        }
        g=k;
        List<List<Integer>> ans=new ArrayList<>();
        List<Integer> list=new ArrayList<>();
        boolean[] f=new boolean[nums.length];
        permutation(nums,f,list,ans);
        String s="";
        for(int num:ans.get(ans.size()-1)){
            s+=num;
        }
        return s;

    }
    void permutation(int[] nums,boolean[] f,List<Integer> list,List<List<Integer>> ans){
        if(g==0){
            return;
        }
        if(list.size()==nums.length){
            ans.add(new ArrayList<>(list));
            g--;
            return;
        }
        for(int i=0;i<nums.length;i++){
            if(!f[i]){
                list.add(nums[i]);
                f[i]=true;
                permutation(nums,f,list,ans);
                f[i]=false;
                list.remove(list.size()-1);
            }
        }
    }
}



Solution - 2 :

class Solution {
    public String getPermutation(int n, int k) {
        k=k-1;
        int fact=1;
        String s="";
        ArrayList<Integer> list=new ArrayList<>();
        for(int i=0;i<n;i++){
            list.add(i+1);
            fact=fact*(i+1);
        }
        while(!list.isEmpty()){
            fact=fact/n;
            n--;
            int index=k/fact;
            s+=list.get(index);
            list.remove(index);
            k=k%fact;
        }
        return s;

    }
}
