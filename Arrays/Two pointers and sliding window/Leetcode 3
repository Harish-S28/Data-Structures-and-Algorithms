class Solution {
    public int lengthOfLongestSubstring(String s) {
        HashMap<Character,Integer> map=new HashMap<>();
        int maxlen=0;
        int r=0;
        for(int i=0;i<s.length();i++){
            char ch=s.charAt(i);
            if(map.containsKey(ch) && r<=map.get(ch)){
                r=map.get(ch)+1;
            }
            map.put(ch,i);
            maxlen=Math.max(maxlen,i-r+1);
        }
        return maxlen;
    }
}

