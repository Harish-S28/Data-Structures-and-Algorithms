class Solution {
    public int lengthOfLongestSubstring(String s) {
        int[] map=new int[256];
        int maxlen=0;
        int r=0;
        Arrays.fill(map,-1);
        for(int i=0;i<s.length();i++){
            int ch=(int)(s.charAt(i));
            if(map[ch]>-1 && r<=map[ch]){
                r=map[ch]+1;
            }
            map[ch]=i;
            maxlen=Math.max(maxlen,i-r+1);
        }
        return maxlen;
    }
}

