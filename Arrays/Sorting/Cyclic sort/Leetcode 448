class Solution {
    public List<Integer> findDisappearedNumbers(int[] arr) {
        int i=1;
        int len=arr.length;
        while(i<=len){
             if(arr[i-1]!=i){
                int temp = arr[i-1];
                if(arr[i-1]==arr[temp-1]){
                    i++;
            }
            else{
                 arr[i-1] = arr[temp-1];
                arr[temp-1] = temp;
            }
             }
            else {
                 i++;
            }
        }
            ArrayList<Integer> list=new ArrayList<Integer>();
            for(int j=1;j<=arr.length;){
                if(arr[j-1]==j){
                    j++;
              }
                else{
                    list.add(j);
                    j++;
                }
            }  
        return list;
    }
}
