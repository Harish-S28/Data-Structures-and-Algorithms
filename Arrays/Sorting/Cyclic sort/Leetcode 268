class Solution {
    public int missingNumber(int[] arr) {
        int len=arr.length;
        int i=0;
       
        while( i<len){
            if(arr[i]!=i && arr[i]<len){
                int temp = arr[i];
                arr[i] = arr[temp];
                arr[temp] = temp;
            }
            else {
                 i++;
            }
       }
       i=0;
       for(int element:arr) {
        if(element==i){
            i++;
        }
        else{
           break;
        }

       } 
       return i;
    }
}
