Solution - 1 :

class Solution {
    public int missingNumber(int[] arr) {
        int n=arr.length;
        int sum=0;
        int sumnat=n*(n+1)/2;
        for(int num:arr){
            sum+=num;
     }
     return sumnat-sum;




